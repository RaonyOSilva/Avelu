PORT=3000
NODE_ENV=development
APP_ENV=development
HOMOLOGATION_MODE=false
INVITE_ONLY=false
INVITE_TTL_HOURS=48
# HOST opcional local; em hospedagem o padrao e 0.0.0.0.
# HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=20000
TRUST_PROXY=false
APP_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=avelu
DB_CONNECTION_LIMIT=10
DB_NETWORK=local
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=10000
DB_QUEUE_LIMIT=100
DB_TLS_MODE=disabled
# DB_TLS_CA: PEM da autoridade certificadora; somente com DB_TLS_MODE=verify.
# Exemplos separados em config/environments; nunca copie o banco local para Railway.
# Homologacao/producao: NODE_ENV=production, APP_ENV=staging ou production.
# Defina explicitamente DB_HOST, DB_USER (nao root), DB_PASSWORD e DB_NAME.
# APP_ORIGIN deve ser a origem HTTPS exata, sem barra final.
# TRUST_PROXY=false e conservador; habilite somente IPs/CIDRs do proxy
# verificados na infraestrutura, separados por virgula. Nunca use true ou 1.
# Em produção: NODE_ENV=production e APP_ORIGIN=https://seu-dominio.com

# Recuperação de senha: remetente verificado e APP_ORIGIN público HTTPS
RESEND_API_KEY=
MAIL_FROM=

# Backups diários criptografados; guarde a chave também fora deste computador.
BACKUP_DIR=
BACKUP_KEY=
MYSQLDUMP_PATH=mysqldump
# Operacao C.4: envio externo desabilitado ate configurar destino independente.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
BACKUP_RETENTION_DAYS=7
BACKUP_TIMEOUT_MS=300000
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
# Somente para ensaios de restauracao em instancia MySQL descartavel.
MYSQL_PATH=mysql
