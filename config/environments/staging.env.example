NODE_ENV=production
APP_ENV=staging
HOMOLOGATION_MODE=true
INVITE_ONLY=true
INVITE_TTL_HOURS=48
# IDs separados por virgula, somente registros ficticios revisados. Vazio = sem vitrine.
HOMOLOGATION_PROFESSIONAL_IDS=
HOMOLOGATION_PLACE_IDS=
RESEND_API_KEY=
MAIL_FROM=
HOST=0.0.0.0
APP_ORIGIN=https://homologacao.example.invalid
TRUST_PROXY=false
DB_NETWORK=railway-private
# Usar a referencia ao servico MySQL do MESMO ambiente Railway.
# RAILWAY_ENVIRONMENT_ID e PORT sao fornecidos pela plataforma.
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_NAME=avelu_staging
DB_USER=avelu_staging_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=10000
# A rede privada Railway e criptografada; TLS MySQL e opcional nessa rede.
DB_TLS_MODE=disabled
# Ativar somente depois de validar cliente MySQL 8 e volume persistente.
BACKUP_DIR=
BACKUP_KEY=
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
MYSQLDUMP_PATH=mysqldump
BACKUP_RETENTION_DAYS=7
BACKUP_TIMEOUT_MS=300000
BACKUP_REMOTE_URL=
BACKUP_REMOTE_TOKEN=
