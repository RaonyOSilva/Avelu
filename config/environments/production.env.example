NODE_ENV=production
APP_ENV=production
HOST=0.0.0.0
APP_ORIGIN=https://avelu.example.invalid
TRUST_PROXY=false
DB_NETWORK=railway-private
# Servico e credenciais EXCLUSIVOS da producao, nunca os da homologacao.
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_NAME=avelu_production
DB_USER=avelu_production_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=10000
DB_TLS_MODE=disabled
